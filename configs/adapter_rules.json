{
  "_instruction": "此配置文件用于动态适配不同格式的机器人数据集。带 'Example_' 前缀的项为教学示例，不会被系统实际执行。编写实际规则时，请参考这些示例。",

  "HDF5": {
    "length_reference_key": "action"
  },
  "ROS": {
    "extra_options": {
      "ignore_topics": ["depth", "compressed"]
    }
  },

  "Example_ROS_Custom": {
    "_comment": "【示例】自定义 ROS 数据包解析规则，将底层的复杂 Topic 映射为简单的标准名称",
    "base_type": "ROS",
    "match_rules": {
      "path_keywords": ["CustomRobot", "test_bag"],
      "file_extensions": [".mcap", ".bag"]
    },
    "image_keys_map": {
      "cam_front": "/camera_front/color/image_raw",
      "cam_wrist": "/camera_wrist/color/image_raw"
    }
  },

  "Example_HDF5_With_Videos": {
    "_comment": "【示例】H5 内 images 是占位/全 0 时，从外部 videos 目录读取真实图像。videos 的 key 是标准相机名，value 是相对 HDF5 文件所在目录的视频路径。",
    "base_type": "HDF5",
    "length_reference_key": "action",
    "image_source": "auto",
    "blank_image_fallback": true,
    "cameras": {
      "cam_head": "observations/images/cam_head",
      "cam_wrist": "observations/images/cam_wrist"
    },
    "videos": {
      "cam_head": "videos/cam_head.mp4",
      "cam_wrist": "videos/cam_wrist.mp4"
    }
  },

  "umi_dual_arm": {
      "base_type": "DASMCAP",
      "cameras": {
          "/robot0/sensor/camera0/compressed": "left_wrist_cam",
          "/robot1/sensor/camera0/compressed": "right_wrist_cam"
      },
      "arm_groups": {
          "left": {
              "pose_topic": "/robot0/vio/eef_pose",
              "gripper_topic": "/robot0/sensor/magnetic_encoder"
          },
          "right": {
              "pose_topic": "/robot1/vio/eef_pose", 
              "gripper_topic": "/robot1/sensor/magnetic_encoder" 
          }
      },
      "base": null 
    },
    
  "HDF5_EmbeddedVideo_RGB": {
    "_comment": "适配 H5 内 observations/camera/rgb/*/images 为空，真实图像在同组 video 字节数组中的数据。",
    "base_type": "HDF5",
    "length_reference_key": "observations/timestamp",
    "image_source": "auto",
    "hdf5_image_color_order": "rgb",
    "video_color_order": "rgb",
    "blank_image_fallback": true,
    "cameras": {
      "cam_head": "observations/camera/rgb/head/images",
      "cam_chest": "observations/camera/rgb/chest/images",
      "cam_left": "observations/camera/rgb/left/images",
      "cam_right": "observations/camera/rgb/right/images"
    },
    "videos": {
      "cam_head": "observations/camera/rgb/head/video",
      "cam_chest": "observations/camera/rgb/chest/video",
      "cam_left": "observations/camera/rgb/left/video",
      "cam_right": "observations/camera/rgb/right/video"
    },
    "arm_groups": {
      "left": {
        "qpos": "observations/arm/left/joints",
        "pose": "observations/arm/left/pose",
        "gripper": "observations/effector/left/position"
      },
      "right": {
        "qpos": "observations/arm/right/joints",
        "pose": "observations/arm/right/pose",
        "gripper": "observations/effector/right/position"
      }
    },
    "base": {
      "chassis_pose": "observations/chassis/pose",
      "chassis_vel": "observations/chassis/vel",
      "neck_joints": "observations/neck/joints",
      "torso_joints": "observations/torso/joints"
    }
  },
    
  "ZhiPingFang": {
    "base_type": "HDF5", 
    "length_reference_key": "observations/arm/left/joints",
    "cameras": {
      "cam_head": "observations/camera/rgb/chest/images",
      "cam_right": "observations/camera/rgb/left/images",
      "cam_left": "observations/camera/rgb/left/images",
      "cam_chest": "observations/camera/rgb/chest/images"
    },
    "arm_groups": {
      "left": {
        "qpos": "observations/arm/left/joints"
      },
      "right": {
        "qpos": "observations/arm/right/joints"
      }
    }
  }
}
